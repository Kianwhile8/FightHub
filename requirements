# Production server
# Waitress runs the app on Windows for local/LAN serving (gunicorn is
# POSIX-only). The Linux container uses gunicorn; both are installed so the
# same requirements file works in either place.
waitress==3.0.2
gunicorn==23.0.0

# Rate-limit storage — only used when RATELIMIT_STORAGE_URL points at Redis,
# but installed unconditionally: without it, setting that variable stops the
# app booting at all rather than degrading to in-memory.
#
# Required in production. The default memory:// backend is per-process, so with
# more than one worker or instance each keeps its own counters and the login
# limit is multiplied by however many are running.
redis==8.1.0

# Object storage — Cloud Run
# Only imported when STORAGE_BACKEND=gcs, but installed always so the image
# needs no separate build variant.
google-cloud-storage==3.13.1

# Billing — Stripe Checkout and webhooks
# Server-side only. No Stripe JavaScript is ever sent to the browser, which is
# what keeps the CSP's `script-src 'self'` intact and keeps the privacy notice's
# "loads nothing from any external server" true of the pages we serve.
#
# The API version is additionally pinned in code (app/services/billing_service.py)
# so that changing the default in the Stripe dashboard cannot alter the shape of
# a webhook payload without a deploy.
stripe==16.0.0
