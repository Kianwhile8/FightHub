# Copy this file to .env and fill in the values.
# Generate SECRET_KEY with: python -c "import secrets; print(secrets.token_hex(32))"

SECRET_KEY=replace-with-a-long-random-hex-string

DATABASE_URL=postgresql://user:password@localhost:5432/fighthub

# This account can read every user's email address and erase any account, so
# the seeder refuses to create it on anything under 12 characters or on a
# well-known weak password. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=replace-with-strong-password

# 0 = production (default), 1 = development with auto-reload
FLASK_DEBUG=0

# ── Serving (python serve.py) ─────────────────────────────────────────────
# 127.0.0.1 = this machine only. 0.0.0.0 = reachable from your LAN.
HOST=127.0.0.1
PORT=5000
# Concurrent requests served at once. Keep <= DB_POOL_SIZE.
WAITRESS_THREADS=8

# ── Database pool ─────────────────────────────────────────────────────────
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# ── Cookies and proxies ───────────────────────────────────────────────────
# Secure cookies are only sent over HTTPS. Leave this at 1 whenever real users
# are logging in. Set to 0 ONLY for plain-HTTP testing on your own LAN —
# with it on and no HTTPS, browsers drop the session and users cannot log in.
SESSION_COOKIE_SECURE=1

# Set to 1 when running behind a tunnel or reverse proxy (Cloudflare Tunnel,
# ngrok, nginx, IIS) so per-user rate limiting sees real client IPs.
# Leaving this at 0 behind a proxy makes every request look like it came from
# the proxy, so one person's failed sign-ins rate-limit everybody.
TRUST_PROXY=0

# ── Security headers ──────────────────────────────────────────────────────
# Send the Content-Security-Policy as report-only instead of enforcing it.
# Useful for one deploy if you have added something that loads an external
# script or stylesheet — check the browser console for violations, fix them,
# then turn this back off. The app is designed to need no external resources.
CSP_REPORT_ONLY=0
# HSTS lifetime in seconds, sent only over HTTPS in production. Default 180
# days. The domain is not submitted to the preload list.
# HSTS_MAX_AGE=15552000

# ── Rate limiting ─────────────────────────────────────────────────────────
# Redis for rate-limit storage. REQUIRED in production: `check-deploy` now
# fails without it rather than warning.
#
# The default in-memory backend keeps its counters inside one process. With N
# workers or N Cloud Run instances the "5 sign-in attempts" limit becomes 5N,
# and because Cloud Run adds instances under load an attacker raises their own
# allowance by attacking harder. One worker on Waitress is the only case where
# in-memory is genuinely equivalent.
# RATELIMIT_STORAGE_URL=redis://localhost:6379/0

# ── Uploads ───────────────────────────────────────────────────────────────
# local = write to UPLOAD_FOLDER on disk. Correct for development and for a VM
# with a persistent disk.
# gcs   = write to a Cloud Storage bucket. REQUIRED on Cloud Run, whose disk is
#         per-instance and is wiped on every deploy.
STORAGE_BACKEND=local
# GCS_BUCKET=fighthub-uploads
# GCS_PREFIX=uploads/
# Serve images by redirecting to the object's public URL instead of streaming
# them through the app. Faster and cheaper, but the bucket's objects must be
# publicly readable — anyone with the URL can fetch them without logging in.
# GCS_PUBLIC_URLS=0

# ── Outbound email (confirmation links) ───────────────────────────────────
# The address users actually reach, used to build links in emails. The app
# cannot infer this reliably from behind a proxy, so set it explicitly.
#
# REQUIRED once BILLING_ENABLED=1: it is what Stripe Checkout returns the user
# to after they pay. Without it there is nowhere to send them back to, and
# check-deploy fails rather than letting that ship.
# PUBLIC_BASE_URL=https://fighthub.example.com
# MAIL_PROVIDER=resend
# MAIL_API_KEY=
# MAIL_FROM=no-reply@fighthub.example.com
# Refuse logins from accounts that have not confirmed their address. Leave off
# until mail is actually sending, or you will lock out new signups.
REQUIRE_VERIFIED_EMAIL=0

# ── Container startup (Docker / Cloud Run) ────────────────────────────────
# Apply pending migrations on boot, serialised by a Postgres advisory lock so
# concurrent instances cannot race. Safe to leave on.
# RUN_MIGRATIONS=1
# Create the admin account from ADMIN_EMAIL / ADMIN_PASSWORD on boot.
# SEED_ADMIN=1
# Gunicorn sizing. Each worker gets its own SQLAlchemy pool, so raising
# WEB_CONCURRENCY multiplies connections against Cloud SQL's limit.
# WEB_CONCURRENCY=1
# WEB_THREADS=8

# ── Billing (Stripe) ──────────────────────────────────────────────────────
# Off by default. With it off, every feature is free, has_active_access()
# returns True for everybody, and /api/billing/* refuses with 503 — so the
# whole paywall can be deployed and inspected before a charge is possible.
BILLING_ENABLED=0

# Secret key from the Stripe dashboard. sk_test_… takes no real money;
# sk_live_… does. check-deploy FAILS on a test key when it detects Cloud Run,
# because a live deploy in test mode looks completely normal and silently never
# charges anybody.
# STRIPE_SECRET_KEY=sk_test_...

# Webhook signing secret. NOTE: the value printed by
#   stripe listen --forward-to localhost:5000/api/billing/webhook
# is NOT the same as the signing secret of a webhook endpoint created in the
# dashboard. Using the wrong one gives a 400 on every delivery, and is the
# single most common local-setup confusion.
# STRIPE_WEBHOOK_SECRET=whsec_...

# PRICE ids (price_…), not product ids (prod_…). Both must be recurring,
# yearly, in GBP. Create them in the Stripe dashboard; check-deploy retrieves
# both and fails if the amount, interval or currency disagrees with the
# PRICE_*_PENCE values below.
#   fighter — individual competitors, £10/year
#   pro     — coaches and promoters,  £20/year
# STRIPE_PRICE_FIGHTER=price_...
# STRIPE_PRICE_PRO=price_...

# Free trial on every new account, in days. Run locally rather than in Stripe:
# it starts at registration, before the user has a Stripe customer, and takes
# no card. Accounts that existed before the paywall shipped are grandfathered
# by the migration instead and never see a trial.
TRIAL_DAYS=7

# Grace after a subscription period ends before access is cut. Webhook delivery
# is at-least-once and can lag, so a renewal Stripe has taken but not yet
# announced must not lock a paying coach out.
BILLING_GRACE_DAYS=2

# What the UI prints. Display only — the authority is the Stripe price, and
# check-deploy fails if these two disagree with it.
PRICE_FIGHTER_PENCE=1000
PRICE_PRO_PENCE=2000
# BILLING_CURRENCY=gbp
